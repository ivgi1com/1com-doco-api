# Do not place real secrets in this file. Names and safe defaults only.
# Live Playground proxy (src/server/playground/config.ts, docs/SECURITY.md).
# The upstream host is fixed in code (src/content/proxy-api.ts) and is not configurable.

# Kill switch. Live proxying is off unless this is exactly "true".
# PLAYGROUND_LIVE_ENABLED=false

# Upstream timeout, ms (default 10000, clamped to 1000..30000).
# PLAYGROUND_REQUEST_TIMEOUT_MS=10000

# Upstream response-size ceiling, bytes (default 1048576, clamped to 1024..5242880).
# PLAYGROUND_MAX_RESPONSE_BYTES=1048576

# Requests per client per rolling minute (default 10, clamped to 1..60). In-memory, per instance.
# PLAYGROUND_RATE_LIMIT=10

# Request header carrying the client IP, set by a reverse proxy you trust (e.g. x-real-ip).
# Unset: no header is trusted and all callers share one rate-limit bucket.
# PLAYGROUND_TRUSTED_IP_HEADER=
